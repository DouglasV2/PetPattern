# OS
.DS_Store
Thumbs.db

# Java
backend/target/
*.class

# Node
frontend/node_modules/
frontend/dist/

# Env
.env
*.env
!.env.example

# DB backups (ops/backup-db.sh)
backups/

# IDE
.idea/
.vscode/
*.iml

# Local test artifacts
*_id.txt

# Logs & database dumps (never commit runtime logs or DB dumps). NB: *.sql is
# intentionally NOT ignored — Flyway migrations under db/migration are source.
*.log
*.dump
*.sql.gz
*.dump.gz

# Distributable archives
*.zip

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Mobile signing material — never commit. NB: this does NOT ignore the
# (future) android/ or ios/ project directories themselves, only the
# secrets and build output that land inside them.
*.jks
*.keystore
*.p12
*.pem
*.key
key.properties
google-services.json
GoogleService-Info.plist

# Capacitor / native build outputs
android/app/build/
android/build/
android/.gradle/
ios/App/build/
ios/App/Pods/
