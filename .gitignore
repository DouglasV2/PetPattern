# OS
.DS_Store
Thumbs.db

# Java
backend/target/
*.class

# Node
frontend/node_modules/
frontend/dist/

# Env
.env
*.env
!.env.example

# DB backups (ops/backup-db.sh)
backups/

# IDE
.idea/
.vscode/
*.iml

# Local test artifacts
*_id.txt

# Logs & database dumps (never commit runtime logs or DB dumps). NB: *.sql is
# intentionally NOT ignored — Flyway migrations under db/migration are source.
*.log
*.dump
*.sql.gz
*.dump.gz

# Distributable archives
*.zip

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Mobile signing material — never commit. NB: this does NOT ignore the
# (future) android/ or ios/ project directories themselves, only the
# secrets and build output that land inside them.
*.jks
*.keystore
*.p12
*.pem
*.key
key.properties
google-services.json
GoogleService-Info.plist

# Capacitor / native build outputs. The native projects live under frontend/, so target those
# paths (each generated project also ships its own .gitignore as belt-and-suspenders).
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/capacitor-cordova-android-plugins/
frontend/ios/App/build/
frontend/ios/App/Pods/
frontend/ios/App/App/public/
frontend/ios/App/App/capacitor.config.json
frontend/ios/App/App/config.xml
frontend/ios/DerivedData/
frontend/ios/**/xcuserdata/
frontend/ios/.build/
# Legacy root-level native paths (kept in case a project is ever generated at repo root)
android/app/build/
android/build/
android/.gradle/
ios/App/build/
ios/App/Pods/
