# Copy to .env and fill in — docker-compose.prod.yml reads these.
# .env is gitignored; never commit real secrets.

# --- Database ---
POSTGRES_DB=petpattern
POSTGRES_USER=petpattern
# REQUIRED. Use a long random string, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# --- Public URL ---
# REQUIRED. The https origin the app is served at. Used for the session cookie
# and CORS. MUST be https in production (the cookie is Secure).
PUBLIC_ORIGIN=https://app.example.com
# Host port the frontend binds to (on 127.0.0.1); your TLS reverse proxy targets it.
FRONTEND_PORT=7317

# --- Demo ---
# "Load Bella demo" button. true keeps it (rate-limited); false removes it in prod.
PETPATTERN_DEMO_ENABLED=true

# --- Password reset email (optional) ---
# OFF by default: the reset link is written to the backend log instead of emailed
# (fine for a very small beta where you can read the log). To send real email,
# set PETPATTERN_MAIL_ENABLED=true and fill the SMTP_* values below.
PETPATTERN_MAIL_ENABLED=false
PETPATTERN_MAIL_FROM=PetPattern <no-reply@petpattern.app>
# Your transactional email provider's SMTP details (e.g. Postmark, SES, Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# How long a reset link stays valid (minutes).
PETPATTERN_RESET_TTL_MINUTES=60

# --- Error tracking (optional, Sentry) ---
# Leave DSNs empty to keep error tracking OFF (nothing is sent). Fill them to
# enable. No pet notes / health content / emails are ever put in error payloads.
# Backend DSN (runtime):
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Frontend DSN (build-time — change requires rebuilding the frontend image):
VITE_SENTRY_DSN=

# --- Product analytics (optional, privacy-friendly) ---
# Leave empty to keep analytics OFF. When set, the frontend sends ONLY a fixed
# set of funnel event names + a timestamp to this URL — never pet names, notes,
# symptoms, emails, or health content. Point it at a privacy-friendly collector.
# Build-time — change requires rebuilding the frontend image. See docs/observability.md.
VITE_ANALYTICS_URL=

# --- Google Sign-In (optional) ---
# Leave empty to keep "Continue with Google" OFF (no button, endpoints 404).
# To enable: create a Web OAuth client in Google Cloud Console → Credentials,
# add your callback as an Authorized redirect URI, and set all three below.
# The secret is server-side only; never expose it to the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# MUST exactly match an Authorized redirect URI on the OAuth client. In prod use
# your https origin, e.g. https://app.example.com/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7317/api/auth/google/callback

# --- AI (optional) ---
# mock = deterministic local reader (default, no key). anthropic = hosted model.
PETPATTERN_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
PETPATTERN_AI_MODEL=claude-haiku-4-5
