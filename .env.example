# Copy to .env and fill in — docker-compose.prod.yml reads these.
# .env is gitignored; never commit real secrets.

# --- Database ---
POSTGRES_DB=petpattern
POSTGRES_USER=petpattern
# REQUIRED. Use a long random string, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# --- Public URL ---
# REQUIRED. The https origin the app is served at. Used for the session cookie
# and CORS. MUST be https in production (the cookie is Secure).
PUBLIC_ORIGIN=https://app.example.com
# Comma-separated origins allowed to call the API. For the web-only deploy this
# can be just PUBLIC_ORIGIN. Add Capacitor origins before building mobile apps:
#   https://app.example.com,http://localhost,capacitor://localhost
PETPATTERN_CORS_ALLOWED_ORIGINS=https://app.example.com
# Host port the frontend binds to (on 127.0.0.1); your TLS reverse proxy targets it.
FRONTEND_PORT=7317

# --- Demo ---
# "Load Bella demo" button + one-click seed. It signs everyone into ONE shared
# demo account (all visitors see and overwrite the same "Bella"), so keep it OFF
# for a public launch. Turn it on (true) ONLY in a separate, isolated demo
# environment. Default is false in docker-compose.prod.yml.
PETPATTERN_DEMO_ENABLED=false

# --- Password reset email ---
# REQUIRED for a public launch. When false, the reset link is only written to the
# backend log (never emailed) — fine for a tiny beta you can read logs for, but
# real users can NOT reset their password. Set true + fill SMTP_* to send email.
# (In prod the raw token is never logged, even when this is false.)
PETPATTERN_MAIL_ENABLED=false
PETPATTERN_MAIL_FROM=PetPattern <no-reply@petpattern.app>
# Your transactional email provider's SMTP details (e.g. Postmark, SES, Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# How long a reset link stays valid (minutes).
PETPATTERN_RESET_TTL_MINUTES=60

# --- Error tracking (optional, Sentry) ---
# Leave DSNs empty to keep error tracking OFF (nothing is sent). Fill them to
# enable. No pet notes / health content / emails are ever put in error payloads.
# Backend DSN (runtime):
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Frontend DSN (build-time — change requires rebuilding the frontend image):
VITE_SENTRY_DSN=

# --- Product analytics (optional, privacy-friendly) ---
# Leave empty to keep analytics OFF. When set, the frontend sends ONLY a fixed
# set of funnel event names + a timestamp to this URL — never pet names, notes,
# symptoms, emails, or health content. Point it at a privacy-friendly collector.
# Build-time — change requires rebuilding the frontend image. See docs/observability.md.
VITE_ANALYTICS_URL=

# --- Google Sign-In (optional) ---
# Leave ALL THREE empty to keep "Continue with Google" OFF (no button, the
# /api/auth/google/** endpoints 404). To enable: create a Web OAuth client in
# Google Cloud Console → Credentials, add your callback as an Authorized redirect
# URI, and set all three below. docker-compose.prod.yml passes these to the
# backend only — the client secret is server-side and never reaches the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# MUST be your PUBLIC https callback and MUST exactly match an Authorized redirect
# URI on the OAuth client. Its origin is also where users land after login, so it
# must be the real app origin — never localhost in production.
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/auth/google/callback

# --- AI (optional) ---
# AI provider:
# mock = deterministic local reader
# anthropic = Anthropic Claude hosted model
# gemini = Google Gemini hosted model
PETPATTERN_AI_PROVIDER=mock

# Generic hosted AI key. Preferred for production if using one provider.
PETPATTERN_AI_API_KEY=

# Or provider-specific:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Recommended Gemini model for cheap note extraction:
PETPATTERN_AI_MODEL=gemini-2.5-flash-lite

# --- Internal analytics (privacy-safe funnel + D1/D7/D30 retention) ---
# On by default. Stores only a one-way pseudonymous ref + allow-listed event types /
# categorical meta — never names, notes, symptoms, emails, or health content.
PETPATTERN_ANALYTICS_ENABLED=true
# Server secret that seeds the one-way pseudonymous ref. Set a strong random value in
# production; changing it resets retention history for existing users (by design).
PETPATTERN_ANALYTICS_REF_SALT=
# Bearer token for the reporting endpoint (GET /api/analytics/report via the
# X-Analytics-Token header). Empty = the report endpoint is disabled (404). Keep secret.
PETPATTERN_ANALYTICS_ADMIN_TOKEN=

# --- API base URL (optional, mobile/native builds) ---
# Leave empty for the web deploy: frontend/src/api.js defaults to '/api' (same
# origin, proxied by nginx). Set this ONLY when the frontend can't rely on a
# relative path — e.g. a Capacitor app bundled without a same-origin proxy —
# in which case it MUST be a full https URL (e.g. https://app.example.com/api).
# Build-time — change requires rebuilding the frontend image.
VITE_API_BASE=
